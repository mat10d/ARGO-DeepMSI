# ============================================
# ARGO-DeepMSI .gitignore
# ============================================

# ============================================
# External Repositories (Never track)
# ============================================
STAMP/
HistoBistro/
HistoBistro_deprecated/

# ============================================
# Data Directories (gitignored, too large)
# ============================================
data/
tables/
results/
logs/

# ============================================
# Cache & Temporary Files
# ============================================
.huggingface_cache/
.cache/
*.pyc
__pycache__/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ============================================
# Environment Files (keep configs, ignore installs)
# ============================================
.venv/
venv/
env/
*.egg

# ============================================
# Credentials & Secrets
# ============================================
.env
admin.txt
*.key
*.pem
credentials.json

# ============================================
# IDE & Editor Files
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
# SLURM Output Files
# ============================================
scripts/out/
*.out
slurm-*.out

# ============================================
# Visualization & Plots (keep in results/)
# ============================================
visualizations/
*.png
*.jpg
*.jpeg
*.pdf
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.pdf

# ============================================
# Model Checkpoints & Weights (too large)
# ============================================
*.pth
*.ckpt
*.pt
*.safetensors
*.h5
*.pkl

# ============================================
# Jupyter Notebook Outputs
# ============================================
*.ipynb_checkpoints/

# ============================================
# OS Generated Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# Keep These Files (exceptions)
# ============================================
# Keep README and documentation
!README.md
!TODO.md
!CLAUDE.md
!PIPELINE.md

# Keep config files
!configs/**/*.yaml
!configs/**/*.yml
!environments/**/*.yml
!environments/**/*.yaml

# Keep utils and scripts (source code)
!utils/**/*.py
!scripts/**/*.py
!scripts/**/*.sh

# Keep example notebooks
!examples/**/*.ipynb
