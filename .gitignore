# ============================================
# ARGO-DeepMSI .gitignore
# ============================================

# ============================================
# Old Code & Data (archived, never track)
# ============================================
old/

# ============================================
# Data Files (raw data, never track)
# ============================================
data/

# ============================================
# Data Directories (gitignored, too large)
# ============================================
results/*
logs/
# Exception: small derived analysis artifacts (PNG, CSV, JSON under 1 MB)
# so the repo stays interpretable to reviewers without filesystem access.
# Heavy artifacts (embeddings.npy, zarrs, model pickles) remain ignored
# because their parent dirs (results/embeddings, results/data, ...) are
# still excluded by `results/*`.
!results/analysis/
!results/analysis/**
!results/autoresearch/
!results/autoresearch/**
# Exclude bulk thumbnail dumps — keep the manifest, drop the PNGs
results/analysis/**/thumbnails/**/*.png
results/analysis/**/thumbnails/**/*.jpg
# Feature caches (reproducible from extraction scripts, too large for git)
results/analysis/**/*.npz

# ============================================
# Cache & Temporary Files
# ============================================
.huggingface_cache/
.cache/
.ruff_cache/
.uv_cache/
.claude/
*.pyc
__pycache__/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ============================================
# Environment Files (keep configs, ignore installs)
# ============================================
.venv/
venv/
env/
.env/
*.egg

# ============================================
# Credentials & Secrets
# ============================================
.env
admin.txt
*.key
*.pem
credentials.json

# ============================================
# IDE & Editor Files
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
# SLURM Output Files
# ============================================
scripts/out/
scripts/archive/
*.out
slurm-*.out

# ============================================
# Visualization & Plots (keep in results/)
# ============================================
*.png
*.jpg
*.jpeg
*.pdf
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.pdf
!results/analysis/**/*.png
!results/autoresearch/**/*.png

# ============================================
# Model Checkpoints & Weights (too large)
# ============================================
*.pth
*.ckpt
*.pt
*.safetensors
*.h5
*.pkl

# ============================================
# Jupyter Notebook Outputs
# ============================================
*.ipynb_checkpoints/

# ============================================
# OS Generated Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# Keep These Files (exceptions)
# ============================================
# Keep README and documentation
!README.md
!TODO.md
!CLAUDE.md
!PIPELINE.md

# Keep config files
!configs/**/*.yaml
!configs/**/*.yml
!environments/**/*.yml
!environments/**/*.yaml

# Keep utils and scripts (source code)
!utils/**/*.py
!scripts/**/*.py
!scripts/**/*.sh

# Keep example notebooks
!examples/**/*.ipynb
