# STAMP Training Config Template
# Used for Stage 6: MIL Training (Cross-Validation)
#
# This config trains on consolidated data from ALL sites
#
# Placeholders (replaced at runtime):
#   ${BASE_DIR}  - Project base directory
#   ${MODEL}     - Feature extractor model name (e.g., ctranspath, virchow2, h-optimus-0)
#   ${N_SPLITS}  - Number of cross-validation folds (default: 3)
#   ${DEVICE}    - CUDA device (default: cuda:0)

crossval:
  # Output directory for cross-validation results
  output_dir: ${BASE_DIR}/results/stage6_training/${MODEL}/all/crossval

  # Clinical table with patient-level labels (MSI status)
  clini_table: ${BASE_DIR}/results/stage4_feature_validation/all_clinical_table.csv

  # Directory containing extracted features (consolidated from all sites)
  feature_dir: ${BASE_DIR}/results/stage3_features/${MODEL}/all

  # Slide table mapping slides to patients
  slide_table: ${BASE_DIR}/results/stage4_feature_validation/all_slide_table.csv

  # Ground truth column name in clinical table
  ground_truth_label: isMSIH

  # Patient ID column name
  patient_label: PATIENT

  # Slide filename column name
  filename_label: FILENAME

  # Categories for classification
  categories:
  - MSI-H
  - MSS

  # Number of cross-validation folds
  n_splits: ${N_SPLITS}

  # Device to run training on
  device: ${DEVICE}

statistics:
  # Output directory for statistics
  output_dir: ${BASE_DIR}/results/stage7_statistics/${MODEL}/all

  # Ground truth column name
  ground_truth_label: isMSIH

  # Positive class for binary metrics
  true_class: MSI-H

  # Prediction CSVs from each cross-validation fold
  pred_csvs:
  - ${BASE_DIR}/results/stage6_training/${MODEL}/all/crossval/split-0/patient-preds.csv
  - ${BASE_DIR}/results/stage6_training/${MODEL}/all/crossval/split-1/patient-preds.csv
  - ${BASE_DIR}/results/stage6_training/${MODEL}/all/crossval/split-2/patient-preds.csv

heatmaps:
  # Output directory for heatmaps
  output_dir: ${BASE_DIR}/results/stage8_visualization/${MODEL}/all/heatmaps

  # Directory containing extracted features
  feature_dir: ${BASE_DIR}/results/stage3_features/${MODEL}/all

  # Directory containing raw WSI files (consolidated or per-site)
  wsi_dir: ${BASE_DIR}/data/all/raw

  # Path to trained model checkpoint
  checkpoint_path: ${BASE_DIR}/results/stage6_training/${MODEL}/all/crossval/split-0/checkpoints/best.ckpt

  # Number of top-scoring tiles to extract
  topk: 10

  # Number of bottom-scoring tiles to extract
  bottomk: 10

  # Device for heatmap generation
  device: ${DEVICE}
